DB_PATH=./data/rss_kindle.db
EPUB_DIR=./data/epubs

# SSRF guard on outbound fetches of feed/article/image URLs: blocks private,
# loopback, link-local, reserved and multicast addresses. On by default -
# there is no auth on the API, so this is what stands between "reachable"
# and "your LAN/cloud metadata endpoint is reachable" if you ever expose it
# past your own network. If a subscribed feed lives on your LAN, prefer
# adding it to SSRF_ALLOWED_HOSTS over disabling the guard.
# SSRF_GUARD_ENABLED=true
# Comma-separated hostnames, bare IPs, or CIDR ranges exempt from the guard,
# e.g. SSRF_ALLOWED_HOSTS=192.168.1.50,nas.lan,10.0.0.0/8
# SSRF_ALLOWED_HOSTS=
